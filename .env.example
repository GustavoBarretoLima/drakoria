# Development only. Copy to .env and choose a local password in both fields.
POSTGRES_PASSWORD=local-change-this
DATABASE_URL=postgresql://drakoria:local-change-this@localhost:5432/drakoria
DATABASE_SSL=disable
# Production: DATABASE_SSL=verify-full; custom CA path if required by provider.
# DATABASE_SSL_CA_FILE=/absolute/path/provider-ca.pem
VITE_API_URL=http://localhost:3001

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Render private network only: DATABASE_SSL=render-internal (RENDER=true).

# Same-origin account portal. Production must use HTTPS.
AUTH_PUBLIC_URL=http://localhost:3001
# Optional public OAuth Web Client ID; do not add a client secret.
# GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
