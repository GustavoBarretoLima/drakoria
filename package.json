{
  "name": "drakoria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test server/tests/*.test.ts",
    "db:migrate": "node --env-file=.env --import tsx server/src/database/migrateCli.ts",
    "db:migrate:deploy": "node --import tsx server/src/database/migrateCli.ts",
    "server:deploy": "npm run db:migrate:deploy && node --import tsx server/src/index.ts"
  },
  "dependencies": {
    "animejs": "^4.4.1",
    "google-auth-library": "^11.2.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
